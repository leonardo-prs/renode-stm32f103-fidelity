// opencode — permissão para acessar pasta do TCC no Windows via WSL
// Escopo mínimo: apenas C:\Users\Leonardo\projects\tcc (== /mnt/c/Users/Leonardo/projects/tcc)
{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    // Acesso a diretório fora do workspace (WASM sandbox) — apenas TCC
    "external_directory": {
      "/mnt/c/Users/Leonardo/projects/tcc/**": "allow"
    },
    // Libera tools que tocam disco externo sem pedir "ask"
    "bash": "allow",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "write": "allow"
  }
}
