# ────────────────────────────────────────────────────────────────────────────
# .clangd — GERADO por CMake (configure_file). NÃO editar manualmente.
# ────────────────────────────────────────────────────────────────────────────
#
# Aponta clangd para o compile_commands.json do binDir do ÚLTIMO preset
# configurado. O CMake substitui @CMAKE_BINARY_DIR@ (definido pelo preset
# per-cenário — build/<cenario>, ver CMakePresets.json).
#
# Workflow: `cmake --workflow --preset <firmware>` (ou task "Build: <firmware>")
# regera este arquivo; o clangd segue o ÚLTIMO preset configurado (compile o
# firmware que está editando).
#
# Este arquivo está em .gitignore (gerado por CMake) e em .ignore com
# !.clangd para que agentes possam lê-lo.
# ────────────────────────────────────────────────────────────────────────────

CompileFlags:
  CompilationDatabase: @CMAKE_BINARY_DIR@
  # `noipa` é atributo do GCC (o compilador real); o clang do clangd não o
  # conhece. Só silencia o aviso no editor — o build continua com -Werror.
  Add: [-Wno-unknown-attributes]
