// .vscode/tasks.json — build e depuração (conveniência: as campanhas não
// dependem do editor; ver README). Tudo roda via scripts/direnv_exec.sh
// (ambiente Nix mesmo sem direnv no editor). Ao criar um firmware novo,
// acrescentar um par "Build"/"Debug: prep" com o preset dele.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: q",
      "type": "shell",
      "command": "scripts/direnv_exec.sh",
      "args": [".", "cmake", "--workflow", "--preset", "q"],
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "Debug: prep q",
      "type": "shell",
      "command": "scripts/direnv_exec.sh",
      "args": [".", "scripts/renode_start.sh", "q"],
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Renode: stop",
      "type": "shell",
      "command": "scripts/renode_stop.sh",
      "problemMatcher": []
    }
  ]
}
