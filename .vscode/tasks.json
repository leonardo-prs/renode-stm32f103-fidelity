// .vscode/tasks.json — build e debug dos firmwares finais (C1–C4).
// Tudo roda via scripts/direnv_exec.sh (garante o ambiente Nix mesmo quando o
// editor não herdou o direnv). Build = `cmake --workflow --preset <fw>`
// (configure idempotente + build). Os labels "Build: <fw>" e "Debug: prep
// <fw>" são referenciados por launch.json.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: c1-functional",
      "type": "shell",
      "command": "scripts/direnv_exec.sh",
      "args": [
        ".",
        "cmake",
        "--workflow",
        "--preset",
        "c1-functional"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build: c1-timing",
      "type": "shell",
      "command": "scripts/direnv_exec.sh",
      "args": [
        ".",
        "cmake",
        "--workflow",
        "--preset",
        "c1-timing"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build: c2",
      "type": "shell",
      "command": "scripts/direnv_exec.sh",
      "args": [
        ".",
        "cmake",
        "--workflow",
        "--preset",
        "c2"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build: c3",
      "type": "shell",
      "command": "scripts/direnv_exec.sh",
      "args": [
        ".",
        "cmake",
        "--workflow",
        "--preset",
        "c3"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build: c4",
      "type": "shell",
      "command": "scripts/direnv_exec.sh",
      "args": [
        ".",
        "cmake",
        "--workflow",
        "--preset",
        "c4"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Debug: prep c1-functional",
      "type": "shell",
      "command": "scripts/direnv_exec.sh",
      "args": [
        ".",
        "scripts/renode_start.sh",
        "c1-functional"
      ],
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Debug: prep c1-timing",
      "type": "shell",
      "command": "scripts/direnv_exec.sh",
      "args": [
        ".",
        "scripts/renode_start.sh",
        "c1-timing"
      ],
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Debug: prep c2",
      "type": "shell",
      "command": "scripts/direnv_exec.sh",
      "args": [
        ".",
        "scripts/renode_start.sh",
        "c2"
      ],
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Debug: prep c3",
      "type": "shell",
      "command": "scripts/direnv_exec.sh",
      "args": [
        ".",
        "scripts/renode_start.sh",
        "c3"
      ],
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Debug: prep c4",
      "type": "shell",
      "command": "scripts/direnv_exec.sh",
      "args": [
        ".",
        "scripts/renode_start.sh",
        "c4"
      ],
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Renode: stop",
      "type": "shell",
      "command": "scripts/renode_stop.sh",
      "problemMatcher": []
    },
    {
      "label": "Fidelity: check (build + gate)",
      "type": "shell",
      "command": "scripts/direnv_exec.sh",
      "args": [
        ".",
        "python3",
        "scripts/fidelity.py",
        "check"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
