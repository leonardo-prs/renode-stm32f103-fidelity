// ────────────────────────────────────────────────────────────────────────────
// .vscode/tasks.json — build por cenário (presets per-cenário), prep de debug
// Renode (build + sobe + espera porta), stop e clean.
// ────────────────────────────────────────────────────────────────────────────
// Portas: OpenOCD/HW usa :3333 (default OpenOCD); Renode usa :3334 e o
// monitor telnet :6512 — HW e simulador coexistem (ver renode/PLAN.md).
//
// Esquema de build: PRESETS PER-CENÁRIO — um preset = um cenário = UMA
// árvore (build/<cenario>/) com o firmware direto em
// build/<cenario>/firmware.elf. NÃO existe build/Debug nem cópia de
// sincronização. Fonte de verdade: CMakePresets.json; wrapper:
// scripts/scenario_build.sh (configure idempotente + build).
//
// Prefixo `scripts/direnv_exec.sh .` obrigatório: tasks são lançadas pelo
// processo do editor (não-shell de login) e o PATH base do WSL não contém
// /nix/var/nix/profiles/default/bin (adicionado só por /etc/profile.d/nix.sh
// em shells de login). O `direnv exec .` direto então falava com
// "environment: nix: command not found" → exit 127 → preLaunchTask abortado.
// O wrapper garante o nix no PATH antes do direnv (guard: se o nix já está
// no PATH, não muda nada).
//
// `problemMatcher` = `$gcc` BUILT-IN do VS Code (casa diagnóstico de compile
// e de linker, com paths relativos ao workspace). Os labels
// "Build: <alvo> (Debug)" são REFERENCIADOS por .vscode/launch.json
// (preLaunchTask dos configs HW) — não renomear sem atualizar o launch. O
// build type é Debug (-O0 -g3) fixo no preset base.
// ────────────────────────────────────────────────────────────────────────────
{
  "version": "2.0.0",
  "tasks": [
    // ══════════════════════════════════════════════════════════════════════
    // Build: configure (idempotente) + build por cenário (preset per-cenário)
    // ══════════════════════════════════════════════════════════════════════
    { "label": "Build: sandbox (Debug)",  "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "sandbox"],  "problemMatcher": ["$gcc"] },
    { "label": "Build: c1 (Debug)",       "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "c1"],       "problemMatcher": ["$gcc"] },
    { "label": "Build: c2 (Debug)",       "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "c2"],       "problemMatcher": ["$gcc"] },
    { "label": "Build: c2busy (Debug)",   "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "c2busy"],   "problemMatcher": ["$gcc"] },
    { "label": "Build: c3 (Debug)",       "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "c3"],       "problemMatcher": ["$gcc"] },
    { "label": "Build: c4 (Debug)",       "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "c4"],       "problemMatcher": ["$gcc"] },
    { "label": "Build: echo (Debug)",     "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "echo"],     "problemMatcher": ["$gcc"] },

    // Firmwares FINAIS do TCC (ABI v2, -O2 fixo no CMakeLists) — s1a..s4b.
    { "label": "Build: s1a (final)", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "s1a"], "problemMatcher": ["$gcc"] },
    { "label": "Build: s1b (final)", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "s1b"], "problemMatcher": ["$gcc"] },
    { "label": "Build: s2a (final)", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "s2a"], "problemMatcher": ["$gcc"] },
    { "label": "Build: s2b (final)", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "s2b"], "problemMatcher": ["$gcc"] },
    { "label": "Build: s3a (final)", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "s3a"], "problemMatcher": ["$gcc"] },
    { "label": "Build: s3b (final)", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "s3b"], "problemMatcher": ["$gcc"] },
    { "label": "Build: s4a (final)", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "s4a"], "problemMatcher": ["$gcc"] },
    { "label": "Build: s4b (final)", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/scenario_build.sh", "s4b"], "problemMatcher": ["$gcc"] },
    { "label": "Fidelity: gate (ELFs finais)", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "python3", "scripts/fidelity.py", "gate"], "problemMatcher": [] },

    // ══════════════════════════════════════════════════════════════════════
    // Debug prep: build do alvo + Renode headless + espera GDB :3334
    // (preLaunchTask dos configs Renode em launch.json; o script mata a
    // instância anterior e espera a porta abrir — ver renode_start.sh).
    // O `--build` roda scenario_build.sh por dentro: o `$gcc` aqui surfa
    // erros de compile também. echo NÃO tem config Renode (peer sem GDB no
    // c4.resc) — o prep do c4 garante o build/echo/firmware.elf.
    // ══════════════════════════════════════════════════════════════════════
    { "label": "Debug: prep sandbox",  "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/renode_start.sh", "sandbox",  "--build"], "presentation": { "reveal": "always" }, "problemMatcher": ["$gcc"] },
    { "label": "Debug: prep c1",       "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/renode_start.sh", "c1",       "--build"], "presentation": { "reveal": "always" }, "problemMatcher": ["$gcc"] },
    { "label": "Debug: prep c2",       "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/renode_start.sh", "c2",       "--build"], "presentation": { "reveal": "always" }, "problemMatcher": ["$gcc"] },
    { "label": "Debug: prep c2busy",   "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/renode_start.sh", "c2busy",   "--build"], "presentation": { "reveal": "always" }, "problemMatcher": ["$gcc"] },
    { "label": "Debug: prep c3",       "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/renode_start.sh", "c3",       "--build"], "presentation": { "reveal": "always" }, "problemMatcher": ["$gcc"] },
    { "label": "Debug: prep c4",       "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/renode_start.sh", "c4",       "--build"], "presentation": { "reveal": "always" }, "problemMatcher": ["$gcc"] },
    // Finais: renode_start.sh GERA build/<fw>/debug.resc (scripts/fidelity.py resc).
    { "label": "Debug: prep s1a", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/renode_start.sh", "s1a", "--build"], "presentation": { "reveal": "always" }, "problemMatcher": ["$gcc"] },
    { "label": "Debug: prep s1b", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/renode_start.sh", "s1b", "--build"], "presentation": { "reveal": "always" }, "problemMatcher": ["$gcc"] },
    { "label": "Debug: prep s2a", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/renode_start.sh", "s2a", "--build"], "presentation": { "reveal": "always" }, "problemMatcher": ["$gcc"] },
    { "label": "Debug: prep s2b", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/renode_start.sh", "s2b", "--build"], "presentation": { "reveal": "always" }, "problemMatcher": ["$gcc"] },
    { "label": "Debug: prep s3a", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/renode_start.sh", "s3a", "--build"], "presentation": { "reveal": "always" }, "problemMatcher": ["$gcc"] },
    { "label": "Debug: prep s3b", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/renode_start.sh", "s3b", "--build"], "presentation": { "reveal": "always" }, "problemMatcher": ["$gcc"] },
    { "label": "Debug: prep s4a", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/renode_start.sh", "s4a", "--build"], "presentation": { "reveal": "always" }, "problemMatcher": ["$gcc"] },
    { "label": "Debug: prep s4b", "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "scripts/renode_start.sh", "s4b", "--build"], "presentation": { "reveal": "always" }, "problemMatcher": ["$gcc"] },

    // ══════════════════════════════════════════════════════════════════════
    // Renode: stop (postDebugTask dos configs Renode; best-effort)
    // ══════════════════════════════════════════════════════════════════════
    {
      "label": "Renode: stop",
      "type": "shell",
      "command": "scripts/direnv_exec.sh",
      "args": [".", "scripts/renode_stop.sh"],
      "problemMatcher": []
    },

    // ══════════════════════════════════════════════════════════════════════
    // Clean por cenário (cada cenário tem sua árvore build/<cenario>/)
    // ══════════════════════════════════════════════════════════════════════
    { "label": "CMake: clean sandbox",  "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "cmake", "--build", "--preset", "sandbox",  "--target", "clean"], "problemMatcher": [] },
    { "label": "CMake: clean c1",       "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "cmake", "--build", "--preset", "c1",       "--target", "clean"], "problemMatcher": [] },
    { "label": "CMake: clean c2",       "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "cmake", "--build", "--preset", "c2",       "--target", "clean"], "problemMatcher": [] },
    { "label": "CMake: clean c2busy",   "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "cmake", "--build", "--preset", "c2busy",   "--target", "clean"], "problemMatcher": [] },
    { "label": "CMake: clean c3",       "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "cmake", "--build", "--preset", "c3",       "--target", "clean"], "problemMatcher": [] },
    { "label": "CMake: clean c4",       "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "cmake", "--build", "--preset", "c4",       "--target", "clean"], "problemMatcher": [] },
    { "label": "CMake: clean echo",     "type": "shell", "command": "scripts/direnv_exec.sh", "args": [".", "cmake", "--build", "--preset", "echo",     "--target", "clean"], "problemMatcher": [] }
  ]
}
