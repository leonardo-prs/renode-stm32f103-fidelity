// .vscode/launch.json — depuração no VS Code (cortex-debug). Conveniência:
// as campanhas não dependem do editor.
//   Renode: servertype external em :3334 (renode/debug.resc via
//   scripts/renode_start.sh). Configurações para a placa (OpenOCD :3333)
//   entram junto com o primeiro firmware #oP.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Renode: q — caso Q-01 (:3334)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "gdbTarget": "localhost:3334",
      "executable": "${workspaceFolder}/build/q/firmware.elf",
      "svdFile": "${workspaceFolder}/vendor/svd/STM32F103.svd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Debug: prep q",
      "postDebugTask": "Renode: stop"
    }
  ]
}
