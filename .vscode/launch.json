// .vscode/launch.json — debug no VS Code (cortex-debug). Conveniência: a
// campanha não depende do editor (scripts/campaign.sh).
//   Renode: servertype external em :3334 (renode/fidelity.resc via
//           scripts/renode_start.sh); placa: OpenOCD + ST-Link (:3333).
// gdbPath vem de settings.json; SVD da ST em vendor/svd/STM32F103.svd.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Renode: c1-functional — C1 resultados (:3334)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "gdbTarget": "localhost:3334",
      "executable": "${workspaceFolder}/build/c1-functional/firmware.elf",
      "svdFile": "${workspaceFolder}/vendor/svd/STM32F103.svd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Debug: prep c1-functional",
      "postDebugTask": "Renode: stop"
    },
    {
      "name": "Renode: c1-timing — C1 tempos (:3334)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "gdbTarget": "localhost:3334",
      "executable": "${workspaceFolder}/build/c1-timing/firmware.elf",
      "svdFile": "${workspaceFolder}/vendor/svd/STM32F103.svd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Debug: prep c1-timing",
      "postDebugTask": "Renode: stop"
    },
    {
      "name": "Renode: c2 — C2 timers (:3334)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "gdbTarget": "localhost:3334",
      "executable": "${workspaceFolder}/build/c2/firmware.elf",
      "svdFile": "${workspaceFolder}/vendor/svd/STM32F103.svd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Debug: prep c2",
      "postDebugTask": "Renode: stop"
    },
    {
      "name": "Renode: c3 — C3 NVIC (:3334)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "gdbTarget": "localhost:3334",
      "executable": "${workspaceFolder}/build/c3/firmware.elf",
      "svdFile": "${workspaceFolder}/vendor/svd/STM32F103.svd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Debug: prep c3",
      "postDebugTask": "Renode: stop"
    },
    {
      "name": "Renode: c4 — C4 USART (:3334)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "external",
      "gdbTarget": "localhost:3334",
      "executable": "${workspaceFolder}/build/c4/firmware.elf",
      "svdFile": "${workspaceFolder}/vendor/svd/STM32F103.svd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Debug: prep c4",
      "postDebugTask": "Renode: stop"
    },
    {
      "name": "Placa: c1-functional — C1 resultados (OpenOCD :3333)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "executable": "${workspaceFolder}/build/c1-functional/firmware.elf",
      "svdFile": "${workspaceFolder}/vendor/svd/STM32F103.svd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Build: c1-functional"
    },
    {
      "name": "Placa: c1-timing — C1 tempos (OpenOCD :3333)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "executable": "${workspaceFolder}/build/c1-timing/firmware.elf",
      "svdFile": "${workspaceFolder}/vendor/svd/STM32F103.svd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Build: c1-timing"
    },
    {
      "name": "Placa: c2 — C2 timers (OpenOCD :3333)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "executable": "${workspaceFolder}/build/c2/firmware.elf",
      "svdFile": "${workspaceFolder}/vendor/svd/STM32F103.svd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Build: c2"
    },
    {
      "name": "Placa: c3 — C3 NVIC (OpenOCD :3333)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "executable": "${workspaceFolder}/build/c3/firmware.elf",
      "svdFile": "${workspaceFolder}/vendor/svd/STM32F103.svd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Build: c3"
    },
    {
      "name": "Placa: c4 — C4 USART (OpenOCD :3333)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "executable": "${workspaceFolder}/build/c4/firmware.elf",
      "svdFile": "${workspaceFolder}/vendor/svd/STM32F103.svd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Build: c4"
    }
  ]
}
