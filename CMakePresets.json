{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "c1-func",
      "inherits": "base",
      "displayName": "c1-func — C1 funcional: instruções, memória e exceções síncronas (vetores em lotes)",
      "cacheVariables": {
        "FIRMWARE": "c1-func"
      }
    },
    {
      "name": "c1-layout",
      "inherits": "base",
      "displayName": "c1-layout — C1 funcional: estado de reset, identidade e layout de memória",
      "cacheVariables": {
        "FIRMWARE": "c1-layout"
      }
    },
    {
      "name": "c1-cycle",
      "inherits": "base",
      "displayName": "c1-cycle — C1 temporal: validação do DWT_CYCCNT e microbenchmarks diferenciais",
      "cacheVariables": {
        "FIRMWARE": "c1-cycle"
      }
    },
    {
      "name": "q01",
      "inherits": "base",
      "displayName": "q01 — Q-01 verificação do observador externo (Renode: gancho × DWT_CYCCNT × traço)",
      "cacheVariables": {
        "FIRMWARE": "q01"
      }
    },
    {
      "name": "q02",
      "inherits": "base",
      "displayName": "q02 — Q-02 instrumentos genéricos do Renode (ganchos de escrita/exceção, monitor)",
      "cacheVariables": {
        "FIRMWARE": "q02"
      }
    },
    {
      "name": "c2-od",
      "inherits": "base",
      "displayName": "c2-od — C2 interrupções, firmware #oD (só Renode; caso e pontos gravados pelo monitor)",
      "cacheVariables": {
        "FIRMWARE": "c2-od"
      }
    },
    {
      "name": "c2",
      "inherits": "base",
      "displayName": "c2 — C2 timers TIM2/TIM3/TIM1 e IRQ de update",
      "cacheVariables": {
        "FIRMWARE": "c2"
      }
    },
    {
      "name": "c3",
      "inherits": "base",
      "displayName": "c3 — C3 NVIC — arbitragem, preempção, máscaras, encadeamento",
      "cacheVariables": {
        "FIRMWARE": "c3"
      }
    },
    {
      "name": "c4",
      "inherits": "base",
      "displayName": "c4 — C4 USART1 em loopback PA9→PA10 (polling)",
      "cacheVariables": {
        "FIRMWARE": "c4"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "c1-func",
      "configurePreset": "c1-func"
    },
    {
      "name": "c1-layout",
      "configurePreset": "c1-layout"
