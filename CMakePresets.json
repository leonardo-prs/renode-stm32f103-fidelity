{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "q",
      "inherits": "base",
      "displayName": "q — caso Q-01: instrumentos do Renode (ganchos, traço, monitor; só Renode)",
      "cacheVariables": {
        "FIRMWARE": "q"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "q",
      "configurePreset": "q"
    }
  ],
  "workflowPresets": [
    {
      "name": "q",
      "steps": [
        {
          "type": "configure",
          "name": "q"
        },
        {
          "type": "build",
          "name": "q"
        }
      ]
    }
  ]
}
