{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "c1-functional",
      "inherits": "base",
      "displayName": "c1-functional — C1 núcleo e memória — resultados (casos funcionais)",
      "cacheVariables": {
        "FIRMWARE": "c1-functional"
      }
    },
    {
      "name": "c1-timing",
      "inherits": "base",
      "displayName": "c1-timing — C1 núcleo e memória — duração de cargas C (bracket DWT)",
      "cacheVariables": {
        "FIRMWARE": "c1-timing"
      }
    },
    {
      "name": "c2",
      "inherits": "base",
      "displayName": "c2 — C2 timers TIM2/TIM3/TIM1 e IRQ de update",
      "cacheVariables": {
        "FIRMWARE": "c2"
      }
    },
    {
      "name": "c3",
      "inherits": "base",
      "displayName": "c3 — C3 NVIC — arbitragem, preempção, máscaras, encadeamento",
      "cacheVariables": {
        "FIRMWARE": "c3"
      }
    },
    {
      "name": "c4",
      "inherits": "base",
      "displayName": "c4 — C4 USART1 em loopback PA9→PA10 (polling)",
      "cacheVariables": {
        "FIRMWARE": "c4"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "c1-functional",
      "configurePreset": "c1-functional"
    },
    {
      "name": "c1-timing",
      "configurePreset": "c1-timing"
    },
    {
      "name": "c2",
      "configurePreset": "c2"
    },
    {
      "name": "c3",
      "configurePreset": "c3"
    },
    {
      "name": "c4",
      "configurePreset": "c4"
    }
  ],
  "workflowPresets": [
    {
      "name": "c1-functional",
      "steps": [
        {
          "type": "configure",
          "name": "c1-functional"
        },
        {
          "type": "build",
          "name": "c1-functional"
        }
      ]
    },
    {
      "name": "c1-timing",
      "steps": [
        {
          "type": "configure",
          "name": "c1-timing"
        },
        {
          "type": "build",
          "name": "c1-timing"
        }
      ]
    },
    {
      "name": "c2",
      "steps": [
        {
          "type": "configure",
          "name": "c2"
        },
        {
          "type": "build",
          "name": "c2"
        }
      ]
    },
    {
      "name": "c3",
      "steps": [
        {
          "type": "configure",
          "name": "c3"
        },
        {
          "type": "build",
          "name": "c3"
        }
      ]
    },
    {
      "name": "c4",
      "steps": [
        {
          "type": "configure",
          "name": "c4"
        },
        {
          "type": "build",
          "name": "c4"
        }
      ]
    }
  ]
}
