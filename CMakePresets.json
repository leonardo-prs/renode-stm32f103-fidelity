{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SCENARIO": "SANDBOX"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SCENARIO": "SANDBOX"
            }
        },
        {
            "name": "Debug-C1",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SCENARIO": "C1"
            }
        },
        {
            "name": "Debug-C2",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SCENARIO": "C2"
            }
        },
        {
            "name": "Debug-C2-Busy",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SCENARIO": "C2",
                "C2_BUSY_LOOP": "ON"
            }
        },
        {
            "name": "Debug-C3",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SCENARIO": "C3"
            }
        },
        {
            "name": "Debug-C4",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SCENARIO": "C4"
            }
        },
        {
            "name": "Debug-ECHO",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SCENARIO": "ECHO"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Debug-C1",
            "configurePreset": "Debug-C1"
        },
        {
            "name": "Debug-C2",
            "configurePreset": "Debug-C2"
        },
        {
            "name": "Debug-C2-Busy",
            "configurePreset": "Debug-C2-Busy"
        },
        {
            "name": "Debug-C3",
            "configurePreset": "Debug-C3"
        },
        {
            "name": "Debug-C4",
            "configurePreset": "Debug-C4"
        },
        {
            "name": "Debug-ECHO",
            "configurePreset": "Debug-ECHO"
        }
    ]
}