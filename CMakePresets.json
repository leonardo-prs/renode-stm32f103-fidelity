{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "sandbox",
            "inherits": "base",
            "displayName": "sandbox — blink LED PC13 (smoke test)",
            "cacheVariables": { "SCENARIO": "SANDBOX" }
        },
        {
            "name": "c1",
            "inherits": "base",
            "displayName": "c1 — núcleo/baseline (Cenário A)",
            "cacheVariables": { "SCENARIO": "C1" }
        },
        {
            "name": "c2",
            "inherits": "base",
            "displayName": "c2 — IRQ baseline (Cenário A)",
            "cacheVariables": { "SCENARIO": "C2" }
        },
        {
            "name": "c2busy",
            "inherits": "base",
            "displayName": "c2busy — busy-loop variant (Cenário A)",
            "cacheVariables": { "SCENARIO": "C2BUSY" }
        },
        {
            "name": "c3",
            "inherits": "base",
            "displayName": "c3 — IRQ arbitration (Cenário A)",
            "cacheVariables": { "SCENARIO": "C3" }
        },
        {
            "name": "c4",
            "inherits": "base",
            "displayName": "c4 — USART1 (Cenário B)",
            "cacheVariables": { "SCENARIO": "C4" }
        },
        {
            "name": "echo",
            "inherits": "base",
            "displayName": "echo — USART peer (Cenário B, máquina 2)",
            "cacheVariables": { "SCENARIO": "ECHO" }
        },
        {
            "name": "s1",
            "inherits": "base",
            "displayName": "s1 — final: núcleo e memória (ABI v1)",
            "cacheVariables": { "SCENARIO": "S1" }
        },
        {
            "name": "s2",
            "inherits": "base",
            "displayName": "s2 — final: TIM2 periódico e resposta IRQ (ABI v1)",
            "cacheVariables": { "SCENARIO": "S2" }
        },
        {
            "name": "s3",
            "inherits": "base",
            "displayName": "s3 — final: USART em loopback passivo (ABI v1)",
            "cacheVariables": { "SCENARIO": "S3" }
        },
        {
            "name": "s4",
            "inherits": "base",
            "displayName": "s4 — final: preempção e arbitragem (ABI v1)",
            "cacheVariables": { "SCENARIO": "S4" }
        }
    ],
    "buildPresets": [
        { "name": "sandbox", "configurePreset": "sandbox" },
        { "name": "c1", "configurePreset": "c1" },
        { "name": "c2", "configurePreset": "c2" },
        { "name": "c2busy", "configurePreset": "c2busy" },
        { "name": "c3", "configurePreset": "c3" },
        { "name": "c4", "configurePreset": "c4" },
        { "name": "echo", "configurePreset": "echo" },
        { "name": "s1", "configurePreset": "s1" },
        { "name": "s2", "configurePreset": "s2" },
        { "name": "s3", "configurePreset": "s3" },
        { "name": "s4", "configurePreset": "s4" }
    ]
}
