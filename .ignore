# Opencode: arquivos em .gitignore que o agente pode ler.
# Use '!' (sintaxe ripgrep) para un-ignorar.

# .clangd é gerado por CMake (configure_file) a cada configure.
# Não vai pro repo (.gitignore) mas o opencode pode ler.
!.clangd

# Diretório de builds; permitir leitura pelo opencode.
!build/
!build/**
