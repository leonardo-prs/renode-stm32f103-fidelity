mach create "s3b"
machine LoadPlatformDescription @renode/stm32f103_hsi8.repl
logLevel 3
emulation SetGlobalQuantum "0.000001"
sysbus.cpu PerformanceInMips 8
emulation CreateUARTHub "loop" true
connector Connect sysbus.usart1 loop
sysbus.usart1 AutoUpdateDelay true
sysbus.usart1 DelayMultiplier 1
sysbus LoadELF @build/s3b/firmware.elf
machine StartGdbServer 3336
