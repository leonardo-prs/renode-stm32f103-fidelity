mach create "dut"
machine LoadPlatformDescription @renode/stm32f103_hsi8.repl
logLevel 3
emulation SetGlobalQuantum "0.000001"
sysbus LoadELF @build/c1/firmware.elf
cpu PerformanceInMips 8
cpu CyclesPerInstruction 1
emulation RunFor "4"
sysbus ReadBytes `sysbus GetSymbolAddress "c1_done"` 1
sysbus ReadBytes `sysbus GetSymbolAddress "c1_n"` 4
sysbus ReadBytes `sysbus GetSymbolAddress "c1_results"` 2800
cpu ExecutedInstructions
cpu ElapsedCycles
quit
