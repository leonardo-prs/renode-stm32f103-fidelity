mach create "dut"
machine LoadPlatformDescription @renode/stm32f103_hsi8.repl
logLevel 3
emulation SetGlobalQuantum "0.0001"
sysbus LoadELF @build/c3/firmware.elf
cpu PerformanceInMips 8
cpu CyclesPerInstruction 1
emulation RunFor "3"
sysbus ReadBytes `sysbus GetSymbolAddress "c3_done"` 1
sysbus ReadBytes `sysbus GetSymbolAddress "c3_n"` 4
sysbus ReadBytes `sysbus GetSymbolAddress "c3_results"` 8192
cpu ExecutedInstructions
cpu ElapsedCycles
quit
