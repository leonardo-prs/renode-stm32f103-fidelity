mach create "dut"
machine LoadPlatformDescription @renode/stm32f103_hsi8.repl
logLevel 3
emulation SetGlobalQuantum "0.000001"
sysbus LoadELF @build/c2busy/firmware.elf
cpu PerformanceInMips 8
cpu CyclesPerInstruction 1
emulation RunFor "1.2"
sysbus ReadBytes `sysbus GetSymbolAddress "c2_done"` 1
sysbus ReadBytes `sysbus GetSymbolAddress "c2_n"` 4
sysbus ReadBytes `sysbus GetSymbolAddress "c2_results"` 8192
cpu ExecutedInstructions
cpu ElapsedCycles
quit
