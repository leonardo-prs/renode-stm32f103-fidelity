mach create "dut"
machine LoadPlatformDescription @data/sweep/stm32f103_hsi8_x9.repl
logLevel 3
emulation SetGlobalQuantum "0.000001000000"
sysbus LoadELF @build/c2/firmware.elf
cpu PerformanceInMips 50
emulation RunFor "0.144444444444"
sysbus ReadBytes `sysbus GetSymbolAddress "c2_done"` 1
sysbus ReadBytes `sysbus GetSymbolAddress "c2_n"` 4
sysbus ReadBytes `sysbus GetSymbolAddress "c2_results"` 8192
cpu ExecutedInstructions
cpu ElapsedCycles
quit
