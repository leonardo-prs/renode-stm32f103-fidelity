mach create "dut"
machine LoadPlatformDescription @data/sweep/stm32f103_hsi8_x9.repl
logLevel 3
emulation SetGlobalQuantum "0.000000120000"
sysbus LoadELF @build/c4/firmware.elf
cpu PerformanceInMips 50
mach create "peer"
machine LoadPlatformDescription @data/sweep/stm32f103_hsi8_x9.repl
sysbus LoadELF @build/echo/firmware.elf
cpu PerformanceInMips 50
emulation CreateUARTHub "hub"
mach set 0
connector Connect sysbus.usart1 hub
mach set 1
connector Connect sysbus.usart1 hub
mach set 0
emulation RunFor "0.888888888889"
sysbus ReadBytes `sysbus GetSymbolAddress "c4_done"` 1
sysbus ReadBytes `sysbus GetSymbolAddress "c4_n"` 4
sysbus ReadBytes `sysbus GetSymbolAddress "c4_results"` 8192
sysbus ReadBytes `sysbus GetSymbolAddress "c4_auxn"` 4
sysbus ReadBytes `sysbus GetSymbolAddress "c4_aux"` 1024
cpu ExecutedInstructions
cpu ElapsedCycles
quit
