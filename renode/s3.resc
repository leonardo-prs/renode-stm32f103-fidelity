# S3 final: passive USART loopback, NO active echo peer; ABI v1.
# Source-confirmed syntax; physical PA9->PA10 and runtime remain to validate.
using sysbus
mach create "s3_hsi8"
machine LoadPlatformDescription @renode/stm32f103_hsi8.repl
logLevel 1
emulation SetGlobalQuantum "0.000001"
sysbus.cpu PerformanceInMips 8
emulation CreateUARTHub "uartLoopback" true
connector Connect sysbus.usart1 uartLoopback
sysbus.usart1 DelayMultiplier 1
sysbus.usart1 AutoUpdateDelay true
# Delivery delay does not correct TXE/TC/ORE or physical TX serialization.
sysbus LoadELF @build/s3/firmware.elf
# Debug workflow only; the collector reserves/remaps a port >=3336.
machine StartGdbServer 3334
log "=== s3: pronta, sem start; loopback passivo, AutoUpdateDelay true ==="
