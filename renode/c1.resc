# renode/c1.resc — script ÚNICO dos três firmwares do C1.
#
# O coletor (scripts/c1/targets.py) define as variáveis antes de incluir
# este arquivo; os padrões abaixo servem para uso manual/depuração:
#
#   renode -e '$elf=@build/c1-func/firmware.elf; i @renode/c1.resc'
#
# O sistema sob teste é a tripla Renode 1.17.0 + plataforma + este script.
# Perfis ($platform):
#   renode/stm32f103_hsi8.repl  plataforma do projeto (a mesma de C2–C4)
#   renode/c1_doc.repl          + correções determinadas pela documentação
#
# Tempo: PerformanceInMips 8 e quantum global de 125 ns (1 instrução por
# quantum). Com quantum maior a tlib contabiliza instruções por bloco
# traduzido e a leitura do CYCCNT perde a resolução de uma instrução
# (material-base, H-T1). Valores fixos para toda a campanha.

$elf ?= @build/c1-func/firmware.elf
$gdb_port ?= 3334
$platform ?= @renode/stm32f103_hsi8.repl
$mips ?= 8
$quantum ?= "0.000000125"

mach create "stm32f103"
machine LoadPlatformDescription $platform
emulation SetGlobalQuantum $quantum
sysbus.cpu PerformanceInMips $mips

sysbus LoadELF $elf
machine StartGdbServer $gdb_port
