// stm32f103_hsi8.repl — STM32F103C8 (Blue Pill), HSI 8 MHz, sem HSE/PLL.
//
// Base: platforms/cpus/stm32f103.repl do Renode 1.17.0, reduzida aos
// periféricos da família medium-density (RM0008 / datasheet STM32F103x8/xB):
// TIM1-TIM4, USART1-3, I2C1-2, GPIOA-D, DMA1, EXTI, AFIO. Removidos do
// original: TIM5-TIM14, USART4/5, DMA2 e FSMC (inexistentes no C8).
// GPIOE-G continuam declarados SÓ porque o modelo STM32F1AFIO do Renode
// exige 7 portas no construtor; nenhum firmware os usa.
//
// Mudanças deliberadas em relação ao original (todas = "clock de 8 MHz"):
//   - flash 64 KiB @0x08000000 e SRAM 20 KiB @0x20000000 com o tamanho real
//     (o original mapeia 512 MiB de flash a partir de 0);
//   - `frequency: 8000000` em USART1, timers, SysTick e DWT.
// O VTOR é deduzido pelo Renode da primeira seção carregada (0x08000000).
//
// Limitações conhecidas do modelo (fonte da versão instalada):
//   - não há modelo de RCC para o F1: escritas em RCC são ignoradas e as
//     frequências dos periféricos são ESTÁTICAS (as abaixo), não seguem os
//     prescalers APB. Só RCC_CR é "tag" com HSION|HSIRDY para o boot;
//   - DWT CYCCNT = tempo virtual × frequency (não ciclos de pipeline).

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x00010000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x00005000

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0          // 4 bits de prioridade implementados (PM0056 §4.3.7)
    systickFrequency: 8000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m3"
    nvic: nvic

usart1: UART.STM32_UART @ sysbus <0x40013800, +0x100>
    frequency: 8000000
    -> nvic@37
    DMARequest -> dma1@4 | dma1@5

usart2: UART.STM32_UART @ sysbus <0x40004400, +0x100>
    frequency: 8000000
    -> nvic@38
    DMARequest -> dma1@6 | dma1@7

usart3: UART.STM32_UART @ sysbus <0x40004800, +0x100>
    frequency: 8000000
    -> nvic@39
    DMARequest -> dma1@2 | dma1@3

i2c1: I2C.STM32F1_I2C @ sysbus 0x40005400
    EventInterrupt -> nvic@31
    ErrorInterrupt -> nvic@32
    TxDMARequest -> dma1@6
    RxDMARequest -> dma1@7

i2c2: I2C.STM32F1_I2C @ sysbus 0x40005800
    EventInterrupt -> nvic@33
    ErrorInterrupt -> nvic@34
    TxDMARequest -> dma1@4
    RxDMARequest -> dma1@5

exti: IRQControllers.STM32F4_EXTI @ sysbus 0x40010400
    numberOfOutputLines: 19
    [0-4] -> nvic@[6-10]
    [5-9] -> nvicInput23@[0-4]
    [10-15] -> nvicInput40@[0-5]

nvicInput23: Miscellaneous.CombinedInput @ none
    numberOfInputs: 5
    -> nvic@23

nvicInput40: Miscellaneous.CombinedInput @ none
    numberOfInputs: 6
    -> nvic@40

gpioPortA: GPIOPort.STM32F1GPIOPort @ sysbus <0x40010800, +0x400>
    invertedAFPins: [[7, 1]]

gpioPortB: GPIOPort.STM32F1GPIOPort @ sysbus <0x40010C00, +0x400>
    invertedAFPins: [[13, 1], [14, 1], [15, 1], [0, 1], [1, 1]]

gpioPortC: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011000, +0x400>

gpioPortD: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011400, +0x400>

gpioPortE: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011800, +0x400>
    invertedAFPins: [[8, 1], [10, 1], [12, 1]]

gpioPortF: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011C00, +0x400>

gpioPortG: GPIOPort.STM32F1GPIOPort @ sysbus <0x40012000, +0x400>

timer1: Timers.STM32_Timer @ sysbus 0x40012c00
    BreakInterrupt -> nvic@24
    UpdateInterrupt -> nvic@25 | dma1@5
    TriggerInterrupt -> nvic@26 | dma1@4
    CommutationInterrupt -> nvic@26 | dma1@4
    CaptureCompareInterrupt -> nvic@27 | dma1@2
    frequency: 8000000
    initialLimit: 0xFFFF

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    IRQ -> nvic@28
    UpdateInterrupt -> dma1@2
    frequency: 8000000
    initialLimit: 0xFFFF

timer3: Timers.STM32_Timer @ sysbus 0x40000400
    IRQ -> nvic@29
    UpdateInterrupt -> dma1@3
    TriggerInterrupt -> dma1@6
    frequency: 8000000
    initialLimit: 0xFFFF

timer4: Timers.STM32_Timer @ sysbus 0x40000800
    IRQ -> nvic@30
    UpdateInterrupt -> dma1@7
    [0-2] -> dma1@[1, 4, 5]
    frequency: 8000000
    initialLimit: 0xFFFF

dma1: DMA.STM32G0DMA @ sysbus 0x40020000
    numberOfChannels: 7
    [0-6] -> nvic@[11-17]

afio: GPIOPort.STM32F1AFIO @ sysbus 0x40010000
    gpioPorts: [gpioPortA, gpioPortB, gpioPortC, gpioPortD, gpioPortE, gpioPortF, gpioPortG]
    [0-15] -> exti@[0-15]

// Ligações de função alternativa timer ↔ pino (do original, só TIM1-TIM4 e
// GPIOA-D). Nenhum firmware habilita saídas de timer; ficam por fidelidade
// à plataforma de referência.
timer1:
    0 -> gpioPortA#08@01 | gpioPortB#13@01 | gpioPortA#07@01 | dma1@2
    1 -> gpioPortA#09@01 | gpioPortB#14@01 | gpioPortB#00@01
    2 -> gpioPortA#10@01 | gpioPortB#15@01 | gpioPortB#01@01 | dma1@6
    3 -> gpioPortA#11@01 | dma1@4

timer2:
    0 -> gpioPortA#00@02 | gpioPortA#15@02 | dma1@5
    1 -> gpioPortA#01@02 | gpioPortB#03@02 | dma1@7
    2 -> gpioPortA#02@02 | gpioPortB#10@02 | dma1@1
    3 -> gpioPortA#03@02 | gpioPortB#11@02 | dma1@7

timer3:
    0 -> gpioPortA#06@03 | gpioPortB#04@03 | gpioPortC#06@03 | dma1@6
    1 -> gpioPortA#07@03 | gpioPortB#05@03 | gpioPortC#07@03
    2 -> gpioPortB#00@03 | gpioPortC#08@03 | dma1@2
    3 -> gpioPortB#01@03 | gpioPortC#09@03 | dma1@3

timer4:
    0 -> gpioPortB#06@04 | gpioPortD#12@04
    1 -> gpioPortB#07@04 | gpioPortD#13@04
    2 -> gpioPortB#08@04 | gpioPortD#14@04
    3 -> gpioPortB#09@04 | gpioPortD#15@04

gpioPortA:
    0 -> timer2@00
    1 -> timer2@01
    2 -> timer2@02
    3 -> timer2@03
    6 -> timer3@00
    7 -> timer1@00 | timer3@01
    8 -> timer1@00
    9 -> timer1@01
    10 -> timer1@02
    11 -> timer1@03
    15 -> timer2@00

gpioPortB:
    0 -> timer1@01 | timer3@02
    1 -> timer1@02 | timer3@03
    3 -> timer2@01
    4 -> timer3@00
    5 -> timer3@01
    6 -> timer4@00
    7 -> timer4@01
    8 -> timer4@02
    9 -> timer4@03
    10 -> timer2@02
    11 -> timer2@03
    13 -> timer1@00
    14 -> timer1@01
    15 -> timer1@02

gpioPortC:
    6 -> timer3@00
    7 -> timer3@01
    8 -> timer3@02
    9 -> timer3@03

gpioPortD:
    12 -> timer4@00
    13 -> timer4@01
    14 -> timer4@02
    15 -> timer4@03

sysbus:
    init:
        Tag <0x40021000, 0x40021003> "RCC_CR" 0x00000083

// DWT depois do bloco sysbus:init e com nome `dwt0`: com o nome `dwt`, ou
// antes do init, o carregamento da plataforma trava na 1.17.0 (verificado
// em 2026-10-07).
dwt0: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 8000000
